QMainWindow {
    background-color: #F5F7FA;
}

QDialog {
    background-color: #FFFFFF;
    color: #111111;
}

QWidget {
    background-color: #FFFFFF;
    color: #111111;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 14px;
}

QLabel {
    color: #111111;
}

QLabel#heading {
    color: #111111;
    font-size: 28px;
    font-weight: 700;
    padding-top: 12px;
}

QLabel#subtitle {
    color: #111111;
    font-size: 15px;
    padding-bottom: 8px;
}

QGroupBox {
    border: 1px solid #D6DCE5;
    border-radius: 7px;
    margin-top: 8px;
    padding: 8px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QDoubleSpinBox {
    border: 1px solid #B8C2D1;
    border-radius: 5px;
    padding: 6px;
    min-width: 90px;
}

QLabel#predictionResult {
    color: #1E3A8A;
    font-weight: bold;
}

QPushButton {
    background-color: #1E3A8A;
    color: #FFFFFF;
    border: 1px solid #1E3A8A;
    border-radius: 7px;
    padding: 10px 18px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #172F70;
}

QPushButton:pressed {
    background-color: #102353;
}

QToolBar {
    background-color: #ffffff;
    border: 1px solid #e1e7f0;
    spacing: 6px;
    padding: 4px;
}
